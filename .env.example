# ============================================================
# PE_saver_agent 环境变量示例
# 复制本文件为 .env 并填入真实值。不填任何值也能用 FakeLLM 离线跑通 demo。
# ============================================================

# ---- LLM 配置（OpenAI 兼容接口，Qwen/DeepSeek/vLLM 均可） ----
# 示例用的是 DeepSeek（便宜）；换成 Qwen 只需改 base/model
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
# DeepSeek 默认开思考模式，关掉拿确定性 JSON（Qwen 等可设为 false）
LLM_DISABLE_THINKING=true

# ---- 嵌入模型（RAG 用，OpenAI 兼容） ----
# 留空则使用内置 HashingEmbedder（离线、非语义、仅演示流程）
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3

# ---- 安全管控 ----
# 工具/技能执行是否强制 DRY-RUN（生产环境务必 true，仅真实救援环境可 false）
SAFETY_DRY_RUN=true
# 允许的挂载目标路径前缀（白名单，防止误操作任意分区）
SAFETY_MOUNT_WHITELIST=/mnt,/media,/dev/sd
# 危险命令黑名单子串（命令注入防护）
SAFETY_DANGEROUS_COMMANDS=rm -rf,mkfs,dd if,fdisk --delete,shutdown,reboot

# ---- 服务 ----
APP_HOST=127.0.0.1
APP_PORT=8000
